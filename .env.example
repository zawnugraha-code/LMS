APP_NAME=Arunika
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arunika
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache & Session & Queue
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@arunika.id"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem
FILESYSTEM_DISK=local

# Search (Meilisearch)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# Broadcasting (Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=arunika
REVERB_APP_KEY=arunika-key
REVERB_APP_SECRET=arunika-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_PER_DAY=1000

# WhatsApp Gateway (optional)
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Horizon
HORIZON_PREFIX=arunika_horizon:

# Pulse
PULSE_ENABLED=true

# Feature Flags
PENNANT_STORE=database

# Testing
DB_TEST_DATABASE=arunika_test
